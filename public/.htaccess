# Apache config for the built site (Hostinger). Vite copies this file into
# dist/ on every build, so it ships with the deploy automatically.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else goes to index.html so React Router can handle the route.
  # Without this, opening or refreshing /slip or /admin returns a 404.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html must never be cached. It is the file that points at the hashed
  # JS/CSS bundles, so a cached copy keeps serving the previous deploy's code
  # even after new files are uploaded.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Asset filenames contain a content hash, so a changed file is a new URL.
  # They are safe to cache indefinitely.
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

# Hide directory listings
Options -Indexes
